# PantryPal — copy to .env and set values
# Database (optional; default is pantry.db in cwd)
# PANTRY_DB_PATH=/data/pantry.db

# Alerts: Telegram (optional)
# TELEGRAM_BOT_TOKEN=your_bot_token_from_BotFather

# Alerts: Email (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=app_password
# ALERT_FROM_EMAIL=your_email@gmail.com
